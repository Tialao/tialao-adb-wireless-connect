{
  "name": "tialao-adb-wireless-connect",
  "displayName": "TIALAO ADB Wireless Connect",
  "description": "Connecte un smartphone Android en ADB sans fil : QR code ou code d'association, sans passer par Android Studio.",
  "version": "0.2.0",
  "license": "MIT",
  "publisher": "tialao",
  "private": true,
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1f2430",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "keywords": [
    "adb",
    "android",
    "wireless",
    "debugging",
    "qrcode",
    "scrcpy",
    "flutter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tialao/tialao-adb-wireless-connect.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/Tialao/tialao-adb-wireless-connect#readme",
  "bugs": {
    "url": "https://github.com/Tialao/tialao-adb-wireless-connect/issues"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tialaoAdb.pairQr",
        "title": "Pair device with QR code",
        "category": "TIALAO ADB",
        "icon": "$(device-mobile)"
      },
      {
        "command": "tialaoAdb.pairCode",
        "title": "Pair device with pairing code",
        "category": "TIALAO ADB"
      },
      {
        "command": "tialaoAdb.connect",
        "title": "Connect to device",
        "category": "TIALAO ADB"
      },
      {
        "command": "tialaoAdb.disconnect",
        "title": "Disconnect device",
        "category": "TIALAO ADB"
      },
      {
        "command": "tialaoAdb.tcpip",
        "title": "Enable TCP/IP mode (legacy, Android 10 and below)",
        "category": "TIALAO ADB"
      },
      {
        "command": "tialaoAdb.restartServer",
        "title": "Restart ADB server",
        "category": "TIALAO ADB"
      },
      {
        "command": "tialaoAdb.showDevices",
        "title": "Show connected devices",
        "category": "TIALAO ADB"
      },
      {
        "command": "tialaoAdb.menu",
        "title": "Open menu",
        "category": "TIALAO ADB"
      },
      {
        "command": "tialaoAdb.mirror",
        "title": "Mirror device screen",
        "category": "TIALAO ADB",
        "icon": "$(device-mobile)"
      },
      {
        "command": "tialaoAdb.openTerminal",
        "title": "Open ADB terminal",
        "category": "TIALAO ADB",
        "icon": "$(terminal)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "tialaoAdb.menu",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "TIALAO ADB Wireless Connect",
      "properties": {
        "tialaoAdb.adbPath": {
          "type": "string",
          "default": "adb",
          "markdownDescription": "Chemin vers le binaire `adb`. Laisser `adb` pour utiliser celui du `PATH` ; l'extension cherche aussi automatiquement dans les emplacements standards du SDK Android.",
          "scope": "machine"
        },
        "tialaoAdb.autoConnectOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Tenter de reconnecter le dernier appareil associe a l'ouverture de la fenetre."
        },
        "tialaoAdb.discoveryTimeout": {
          "type": "number",
          "default": 120,
          "minimum": 10,
          "maximum": 600,
          "description": "Timeout de decouverte mDNS, en secondes."
        },
        "tialaoAdb.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Afficher l'appareil connecte dans la barre d'etat."
        },
        "tialaoAdb.disableMdnsAutoConnect": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Redemarrer le serveur adb avec `ADB_MDNS_AUTO_CONNECT` vide, pour empecher adb de se connecter tout seul aux appareils decouverts. **Attention** : le redemarrage du serveur coupe les sessions adb en cours (Gradle, Flutter, scrcpy)."
        },
        "tialaoAdb.mirrorMaxSize": {
          "type": "number",
          "default": 1280,
          "minimum": 320,
          "maximum": 3840,
          "markdownDescription": "Plus grande dimension de l'image encodee pour le miroir. Reduire allege l'encodage et le reseau ; l'affichage reste redimensionnable librement.",
          "scope": "machine-overridable"
        },
        "tialaoAdb.mirrorBitRate": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 50,
          "markdownDescription": "Debit video vise pour le miroir, en Mbit/s.",
          "scope": "machine-overridable"
        },
        "tialaoAdb.mirrorMaxFps": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 120,
          "markdownDescription": "Images par seconde maximales pour le miroir. `0` laisse l'appareil decider.",
          "scope": "machine-overridable"
        },
        "tialaoAdb.scrcpyServerPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Chemin d'un `scrcpy-server` de remplacement. Laisser vide pour utiliser celui fourni avec l'extension (scrcpy 3.1, verifie par empreinte SHA-256 avant chaque envoi sur l'appareil).",
          "scope": "machine"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run build && vsce package --no-dependencies --out ../../tialao-adb-wireless-connect.vsix",
    "vsce:ls": "vsce ls --no-dependencies"
  },
  "dependencies": {
    "tialao-adb-wireless": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "L'extension lance le binaire adb configuré et pousse un serveur sur l'appareil connecté."
    }
  }
}
